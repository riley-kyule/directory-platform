APP_NAME="Directory Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PRIVILEGED_MFA_SESSION_HOURS=12
LAUNCH_CHECK_REQUIRE_GOOGLE_SSO=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ADMIN_ALLOWED_DOMAINS=
OPS_SCHEDULER_STALE_MINUTES=5
OPS_BACKUP_STALE_HOURS=30
OPS_QUEUE_AGE_WARNING_MINUTES=10
OPS_DISK_FREE_WARNING_MEGABYTES=2048
OPS_SLOW_QUERY_MILLISECONDS=500
OPS_BACKUP_DISK=local
OPS_BACKUP_DIRECTORY=backups
OPS_BACKUP_RETENTION_DAYS=14
OPS_RESTORE_DRILL_STALE_DAYS=30
OPS_SEARCH_TERM_LOG_RETENTION_DAYS=180
OPS_PROFILE_CONVERSION_RETENTION_DAYS=400
OPS_REVIEW_DUPLICATE_WINDOW_DAYS=90
OPS_REVIEW_PII_RETENTION_DAYS=90
OPS_REPORT_PII_RETENTION_DAYS=365
OPS_MODERATION_URGENT_SLA_MINUTES=60
OPS_MODERATION_NORMAL_SLA_HOURS=24
OPS_MODERATION_APPEAL_SLA_HOURS=72
OPS_MODERATION_ESCALATION_STALE_MINUTES=30
OPS_QUEUE_WORKER_STALE_MINUTES=5
OPS_PRIVACY_RETENTION_STALE_HOURS=26
# Required before `system:restore-drill` will run: a database distinct from
# DB_* above (different host/port/database, or a different sqlite file) that
# the command can safely wipe and reimport a backup into. Left unset by
# default so the command fails closed rather than guessing a target.
# OPS_RESTORE_DRILL_DB_DRIVER=mysql
# OPS_RESTORE_DRILL_DB_HOST=127.0.0.1
# OPS_RESTORE_DRILL_DB_PORT=3306
# OPS_RESTORE_DRILL_DB_DATABASE=
# OPS_RESTORE_DRILL_DB_USERNAME=root
# OPS_RESTORE_DRILL_DB_PASSWORD=

# Lets Admin > Settings check for and trigger deploys without SSH, by running
# deploy/deploy.sh from a background job. Off by default. SELF_DEPLOY_REPO_URL
# may need an embedded token for non-interactive git access — keep it here
# only, never commit it. SELF_DEPLOY_APP_ROOT is the parent of releases/
# shared/current (e.g. /home/youruser/yourdomain.com), not this release's own
# path. Match SELF_DEPLOY_MANAGE_DOCROOT to whatever you passed deploy.sh
# manually — see deploy/bootstrap.sh's header comment.
# SELF_DEPLOY_ENABLED=true
# SELF_DEPLOY_REPO_URL=https://github.com/youruser/yourrepo.git
# SELF_DEPLOY_BRANCH=main
# SELF_DEPLOY_APP_ROOT=/home/youruser/yourdomain.com
# SELF_DEPLOY_MANAGE_DOCROOT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Fallback used only before the database is migrated/seeded. Production mail
# delivery is configured from Admin → Settings → Mail delivery and stored
# encrypted in the database, so SMTP credentials do not need to live here.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DIRECTORY_SITEMAP_CHUNK_SIZE=10000
DIRECTORY_ONLINE_MINUTES=30
DIRECTORY_RECENTLY_ACTIVE_MINUTES=360
