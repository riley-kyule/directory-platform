# =============================================================================
#  Production environment — fill in every line marked  <<< SET THIS
#  bootstrap.sh copies this to  <app root>/shared/.env  on the first run if no
#  .env exists there yet. deploy.sh generates APP_KEY for you automatically.
# =============================================================================

APP_NAME="Your Directory"                      # <<< SET THIS — shown in the browser tab and emails
APP_ENV=production
APP_KEY=                                        # left blank on purpose — deploy.sh fills it in
APP_DEBUG=false
APP_URL=https://example.com                     # <<< SET THIS — your real https:// address, no trailing slash
CANONICAL_HOST=example.com                      # <<< SET THIS — the bare hostname from APP_URL (no https://)

# Reverse proxy / CDN. If you use Cloudflare or similar, put its IP ranges here
# (comma-separated). If visitors hit the server directly, leave it empty.
TRUSTED_PROXIES=

# ---- Database (cPanel > MySQL Databases) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                                    # <<< SET THIS — e.g. cpaneluser_directory
DB_USERNAME=                                    # <<< SET THIS — e.g. cpaneluser_app
DB_PASSWORD=                                    # <<< SET THIS

# ---- Staff sign-in ----------------------------------------------------------
# Staff/admin accounts sign in with Google. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and paste them here.
# To launch WITHOUT Google sign-in, set LAUNCH_CHECK_REQUIRE_GOOGLE_SSO=false
# and staff will use email + password + 2FA instead.
LAUNCH_CHECK_REQUIRE_GOOGLE_SSO=true
GOOGLE_CLIENT_ID=                               # <<< SET THIS (or turn the check off above)
GOOGLE_CLIENT_SECRET=                           # <<< SET THIS (or turn the check off above)
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ADMIN_ALLOWED_DOMAINS=                   # optional: restrict staff sign-in to your email domain

# ---- Storage / queues / cache (leave as-is for a standard cPanel install) ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# ---- Mail -----------------------------------------------------------------
# Real mail delivery is configured later in the app: Admin > Settings > Mail
# delivery. This value is only used before that is set up; "sendmail" works on
# most cPanel accounts out of the box.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="noreply@example.com"         # <<< SET THIS
MAIL_FROM_NAME="${APP_NAME}"

# ---- Backups --------------------------------------------------------------
# Nightly backups are written here. "local" keeps them on the same server,
# which is better than nothing but not disaster-proof. For a real launch,
# point OPS_BACKUP_DISK at off-server storage (e.g. an S3 bucket) and fill in
# the AWS_* values below.
OPS_BACKUP_DISK=local
OPS_BACKUP_DIRECTORY=backups
OPS_BACKUP_RETENTION_DAYS=14
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# ---- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
